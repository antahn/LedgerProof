# Secrets never touch git. .env holds real keys; .env.example holds names only.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
dist/
build/

# artifacts/ IS committed — it is the evidence base for every claimed number.
# Only secrets are excluded, never results.
#
# ...except process logs. artifacts/logs/ holds raw stdout from the ingest and
# worker processes the harness starts; it is rewritten on every run and is a
# debugging aid, not a result. Tracking it made every harness run dirty the
# tree and bury real diffs in log churn.
artifacts/logs/

# Draft write-up — authored and published by hand, deliberately not tracked
# so the repo doesn't pre-empt the post. Delete this rule to publish it here.
writeup/POST.md

# OS / editor noise
.DS_Store
Thumbs.db
