# Copy to .env and fill in. .env is gitignored; this file holds names only.
#
# TEST MODE ONLY. Keys must start with sk_test_ / whsec_. A live key (sk_live_)
# must never appear in this repo, in .env, or in any command.

# Stripe sandbox secret key (sk_test_...)
STRIPE_SECRET_KEY=

# Webhook endpoint signing secret (whsec_..., printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Postgres (local docker-compose defaults; not secrets)
# e.g. postgresql://postgres:ledgerproof@localhost:5432/ledgerproof
DATABASE_URL=
# e.g. postgresql://postgres:ledgerproof@localhost:5432/ledgerproof_test
TEST_DATABASE_URL=
# Least-privilege application role (INSERT/SELECT only — no UPDATE/DELETE):
# e.g. postgresql://ledger_app:ledger_app@localhost:5432/ledgerproof
APP_DATABASE_URL=

# Redis (local docker-compose default; not a secret)
# e.g. redis://localhost:6379/0
REDIS_URL=

# Claude API key — Phase 5 (triage benchmark) only
ANTHROPIC_API_KEY=
